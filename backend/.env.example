# LLM 配置（优先 OpenAI 兼容变量）
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=
LLM_MODEL=MiniMax-M2.7

# 兼容旧配置：仅在未配置 OPENAI_BASE_URL 时生效
# LLM_API=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# LLM_API_KEY=
LLM_LOG_V=true

# Voicebox TTS 配置
VOICEBOX_API=http://localhost:8000
# 主持人/系统播报默认音色 profile_id（从 voicebox 后台获取）
VOICEBOX_HOST_PROFILE_ID=Rhett-2025

# AI 玩家名称（用逗号分隔）
AI_PLAYER_NAMES=猴哥,八戒,吕布,曹操,关羽,刘备
