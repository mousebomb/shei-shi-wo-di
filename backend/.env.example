# LLM 配置（优先 OpenAI 兼容变量）
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=
LLM_MODEL=MiniMax-M2.7

# 兼容旧配置：仅在未配置 OPENAI_BASE_URL 时生效
# LLM_API=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# LLM_API_KEY=
LLM_LOG_V=true

# Voicebox TTS 配置
VOICEBOX_API=http://127.0.0.1:17493
# 主持人/系统播报默认音色 profile_name（从 voicebox 后台获取）
VOICEBOX_HOST_PROFILE_NAME=Rhett-2025
# 可选：AI 人格默认音色 profile_name（不填则复用主持人音色）
# VOICEBOX_AI_PROFILE_NAME=Rhett-2025
# 兼容旧配置：仍支持 VOICEBOX_HOST_PROFILE_ID

# AI 角色库（姓名/人格/音色）已迁移到 src/constants/aiRoles.ts
